# TanchTV settings. Copy to .env (never commit .env) and fill in.
# Keep comments on their own lines: some Docker Compose versions don't strip inline comments.

# ---- First admin ------------------------------------------------------------------------------
# Password for the built-in "admin" account. Used ONLY on the very first start (empty database).
# Leave empty to get a random one, printed once in:  docker logs tanchtv-app
# Sign in at https://<your-host>/login?admin, then add a passkey (My account -> Passkeys).
# Later changes only through the CLI:  docker exec -it tanchtv-app python cli.py admin password
TVR_PASSWORD=

# ---- Web app ----------------------------------------------------------------------------------
# HTTP port of the app. Put an https reverse proxy in front of it (passkeys and Google need https).
PORT=8095
# Stop a viewer's stream after this many seconds paused or not reporting.
IDLE_KILL_SECONDS=120

# ---- WebRTC -----------------------------------------------------------------------------------
# Network interfaces whose addresses go2rtc offers to browsers (comma list; empty = all).
# Listing only the LAN and VPN interfaces keeps docker bridges out, e.g.  eth0,tailscale0
WEBRTC_INTERFACES=

# ---- Video encoding (read by go2rtc/capture.sh) -------------------------------------------------
# vaapi = Intel/AMD GPU (recommended), none = CPU encoding with libx264
HWACCEL=vaapi
VAAPI_DEVICE=/dev/dri/renderD128
# iHD = modern Intel (incl. Arc), i965 = older Intel, radeonsi = AMD
LIBVA_DRIVER_NAME=iHD
# MS2109-type cards give 1080p only as MJPEG, at most 30 fps
CAPTURE_FORMAT=mjpeg
CAPTURE_SIZE=1920x1080
CAPTURE_FPS=30
VIDEO_BITRATE=5M
